<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Uhr lesen lernen</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --font-h:'Fredoka','Baloo 2','Nunito','Trebuchet MS',system-ui,sans-serif;
  --font-b:'Nunito',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --vh:100vh;

  --bg-a:#d6efff; --bg-b:#fff2d9;
  --glow1:rgba(255,200,61,.42); --glow2:rgba(139,92,246,.20); --glow3:rgba(24,169,87,.20);
  --surface:#ffffff; --surface-2:#eef3ff; --ink:#1b2547; --muted:#57628c; --line:#d5def8;

  --blue:#3b82f6;   --blue-d:#1d4ed8;
  --coral:#ff6b5e;  --coral-d:#d63e32;
  --green:#18a957;  --green-d:#0f7a3d;
  --yellow:#ffc83d; --yellow-d:#c98f00;
  --purple:#7c5cf0; --purple-d:#5535c9;
  --pink:#ec4899;   --pink-d:#b5266f;
  --orange:#f97316; --orange-d:#c2410c;

  --face:#fffdf7; --clock-ink:#1b2547; --clock-tick:#9aa6cf;
  --bezel:#2f3d73; --bezel-ink:#e6ebff; --hub:#1b2547;
  --card-shadow:0 10px 28px rgba(35,50,110,.14);

  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@supports (height:100dvh){ :root{ --vh:100dvh; } }

@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg-a:#0e1436; --bg-b:#261b55;
    --glow1:rgba(255,200,61,.10); --glow2:rgba(139,92,246,.30); --glow3:rgba(59,130,246,.24);
    --surface:#1e2657; --surface-2:#2a3470; --ink:#f1f3ff; --muted:#aab4e3; --line:#39449a;
    --bezel:#6f80dd; --bezel-ink:#ffffff;
    --card-shadow:0 10px 28px rgba(0,0,0,.38);
  }
}
:root[data-theme="dark"]{
  --bg-a:#0e1436; --bg-b:#261b55;
  --glow1:rgba(255,200,61,.10); --glow2:rgba(139,92,246,.30); --glow3:rgba(59,130,246,.24);
  --surface:#1e2657; --surface-2:#2a3470; --ink:#f1f3ff; --muted:#aab4e3; --line:#39449a;
  --bezel:#6f80dd; --bezel-ink:#ffffff;
  --card-shadow:0 10px 28px rgba(0,0,0,.38);
}

*{box-sizing:border-box}
[hidden]{display:none !important}
html,body{height:100%;margin:0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  font-family:var(--font-b);color:var(--ink);
  background-color:var(--bg-a);
  background-image:
    radial-gradient(520px 380px at 6% 4%,var(--glow1),transparent 70%),
    radial-gradient(560px 420px at 96% 18%,var(--glow2),transparent 70%),
    radial-gradient(640px 480px at 60% 104%,var(--glow3),transparent 70%),
    linear-gradient(165deg,var(--bg-a),var(--bg-b));
  background-attachment:fixed;
  overflow:hidden;overscroll-behavior:none;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;
}
:focus-visible{outline:4px solid var(--yellow);outline-offset:3px;border-radius:12px}
button{font:inherit}

/* ---------- Layout-Grundgerüst ---------- */
#app{height:100%;position:relative}
.screen{
  height:100%;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;gap:12px;
  padding:12px max(clamp(12px,3vw,36px),env(safe-area-inset-right)) 22px max(clamp(12px,3vw,36px),env(safe-area-inset-left));
  animation:fadeIn .3s ease both;
}
.screen::-webkit-scrollbar{display:none}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

.topbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex:none}
.topbar-title{
  margin:0;flex:1;text-align:center;line-height:1.1;
  font-family:var(--font-h);font-weight:700;font-size:clamp(20px,4.2vw,34px);
}
.topbar-right{display:flex;align-items:center;gap:8px}
.pill{
  display:inline-flex;align-items:center;gap:.4em;background:var(--surface);border-radius:999px;
  padding:.4em .95em;font-family:var(--font-h);font-weight:600;font-size:clamp(15px,2.4vw,20px);
  box-shadow:var(--card-shadow);white-space:nowrap;
}
.pill.bump{animation:bump .5s}
@keyframes bump{40%{transform:scale(1.25) rotate(-3deg)}}
.icon-btn{
  width:44px;height:44px;flex:none;border-radius:50%;border:0;background:var(--surface);color:var(--ink);
  font-size:20px;line-height:1;box-shadow:var(--card-shadow);cursor:pointer;display:grid;place-items:center;
  transition:transform .1s;
}
.icon-btn:active{transform:scale(.9)}
.icon-btn.sm{width:38px;height:38px;font-size:17px}

.btn{
  --c:var(--blue);--cd:var(--blue-d);
  display:inline-flex;align-items:center;justify-content:center;gap:.5em;
  font-family:var(--font-h);font-weight:600;color:#fff;background:var(--c);border:0;border-radius:999px;
  padding:.7em 1.4em;cursor:pointer;
  box-shadow:0 6px 0 var(--cd),0 14px 22px rgba(20,30,90,.16);
  transition:transform .08s,box-shadow .08s,filter .2s;
}
.btn:hover{filter:brightness(1.07)}
.btn:active{transform:translateY(5px);box-shadow:0 1px 0 var(--cd)}
.btn:disabled{opacity:.55;cursor:default;transform:none;filter:none}
.btn-green{--c:var(--green);--cd:var(--green-d)}
.btn-blue{--c:var(--blue);--cd:var(--blue-d)}
.btn-purple{--c:var(--purple);--cd:var(--purple-d)}
.btn-pink{--c:var(--pink);--cd:var(--pink-d)}
.btn-ghost{--c:var(--surface);--cd:var(--line);color:var(--ink)}
.btn-sm{font-size:clamp(14px,2.2vw,18px);padding:.55em 1.1em;box-shadow:0 4px 0 var(--cd),0 8px 14px rgba(20,30,90,.12)}
.btn-big{font-size:clamp(24px,4.4vw,38px);padding:.55em 1.6em}
.hide-sm{display:inline}
@media (max-width:480px){.hide-sm{display:none}}

.levels{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;flex:none}
.chip{
  border:0;cursor:pointer;color:var(--muted);background:var(--surface);border-radius:999px;
  font-family:var(--font-h);font-weight:600;font-size:clamp(13px,2vw,17px);
  padding:.35em .85em .35em .4em;display:inline-flex;gap:.45em;align-items:center;box-shadow:0 3px 0 var(--line);
}
.chip b{display:inline-grid;place-items:center;width:1.7em;height:1.7em;border-radius:50%;background:var(--surface-2);color:var(--ink);font-size:.9em}
.chip.on{background:var(--blue);color:#fff;box-shadow:0 3px 0 var(--blue-d)}
.chip.on b{background:rgba(255,255,255,.25);color:#fff}
@media (max-width:520px){.chip:not(.on) span{display:none}.chip:not(.on){padding:.35em .4em}}
.chip.mode{padding:.35em .95em}
.chip.mode.on{background:var(--purple);box-shadow:0 3px 0 var(--purple-d)}
.sep{width:10px}

.clock-wrap{
  width:min(100%,var(--cs,300px),640px);aspect-ratio:1;border-radius:50%;
  filter:drop-shadow(0 16px 22px rgba(20,30,80,.28));
}
.clock{width:100%;height:100%;display:block;overflow:visible;touch-action:none}
.clk-bezel{fill:var(--bezel)}
.clk-face{fill:var(--face)}
.clk-mnum{font-family:var(--font-b);font-weight:800;font-size:9.5px;fill:var(--bezel-ink);text-anchor:middle;dominant-baseline:central}
.clk-num{font-family:var(--font-h);font-weight:700;fill:var(--clock-ink);text-anchor:middle;dominant-baseline:central}
.tk-h{stroke:var(--clock-ink);stroke-width:3.4;stroke-linecap:round}
.tk-m{stroke:var(--clock-tick);stroke-width:1.3;stroke-linecap:round}
.hand,.hand-nt{transform-origin:130px 130px;transform-box:view-box}
.hand{transition:transform .24s cubic-bezier(.34,1.45,.64,1)}
.snap .hand{transition:none !important}
.sec-g{transition:transform .35s cubic-bezier(.4,2.1,.55,1)}
.hh{fill:var(--coral)} .mh{fill:var(--blue)}
.sh{fill:rgba(0,0,0,.2)}
.kn{stroke:#fff;stroke-width:2.5}
.kn-h{fill:var(--coral)} .kn-m{fill:var(--blue)}
.clk-hub{fill:var(--hub)}
.hit{stroke:transparent;stroke-linecap:round;pointer-events:stroke;cursor:grab}
.dragging .hit{cursor:grabbing}
.ghost{opacity:0;transition:opacity .3s;pointer-events:none}
.show-ghost .ghost{opacity:1}
.gh{fill:rgba(24,169,87,.22);stroke:var(--green);stroke-width:2.5;stroke-dasharray:5 4}
.clk-n24{display:none;font-family:var(--font-h);font-weight:600;fill:var(--purple-d);text-anchor:middle;dominant-baseline:central}
.show24 .clk-n24{display:inline}
.dp{position:absolute;top:5%;right:7%;font-size:22px;font-size:clamp(14px,3.4vw,26px);line-height:1}
.idle .kn{animation:knob 1.5s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
@keyframes knob{50%{transform:scale(1.35)}}

.play{
  --cs:max(230px,calc(var(--vh) - 470px));
  flex:1;min-height:0;display:grid;gap:14px;justify-items:center;align-content:center;
  grid-template-columns:minmax(0,1fr);grid-template-areas:"task" "stage" "actions";
}
.play.read{--cs:max(230px,calc(var(--vh) - 410px));grid-template-areas:"stage" "task" "actions"}
@media (min-width:860px) and (min-aspect-ratio:5/4){
  .play,.play.read{
    --cs:max(260px,calc(var(--vh) - 175px));
    grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);grid-template-rows:1fr 1fr;
    grid-template-areas:"stage task" "stage actions";column-gap:clamp(20px,4vw,60px);
  }
  .play .task{align-self:end}
  .play .actions{align-self:start}
}
.stage{grid-area:stage;width:100%;display:grid;place-items:center;align-self:center}
.stage.ok .clock-wrap{animation:okpulse .9s ease-out}
@keyframes okpulse{0%{box-shadow:0 0 0 0 rgba(24,169,87,.7)}100%{box-shadow:0 0 0 46px rgba(24,169,87,0)}}

.card{background:var(--surface);border-radius:28px;box-shadow:var(--card-shadow);padding:clamp(12px,2.4vw,22px)}
.task{grid-area:task;position:relative;text-align:center;width:min(100%,540px)}
.task-tools{position:absolute;top:10px;right:10px;display:flex;gap:6px;z-index:2}
.task-label{color:var(--muted);font-weight:800;font-size:clamp(14px,2.2vw,20px);padding:0 44px}
.task-time{font-family:var(--font-h);font-weight:700;font-size:clamp(42px,9vw,84px);line-height:1.05;color:var(--blue)}
.task-time small{font-size:.38em;color:var(--ink);margin-left:.2em}
.task-words{
  display:inline-block;margin-top:.3em;background:var(--surface-2);border-radius:999px;
  font-weight:800;font-size:clamp(16px,2.6vw,24px);padding:.25em .9em;
}
.task-meta{margin-top:.6em;color:var(--muted);font-weight:800;font-size:clamp(13px,2vw,17px)}
.task-meta b{color:var(--orange)}
.actions{grid-area:actions;width:min(100%,540px);display:flex;flex-direction:column;align-items:center;gap:12px}
.feedback{min-height:60px;width:100%;display:grid;place-items:center;text-align:center;font-family:var(--font-h);font-weight:600;font-size:clamp(16px,2.6vw,22px)}
.fb{padding:.55em 1em;border-radius:22px;background:var(--surface);box-shadow:var(--card-shadow);max-width:100%;animation:pop .35s}
.fb.good{background:var(--green);color:#fff}
.fb.bad{background:#fff1de;color:#8a4300;border:3px solid var(--orange);animation:wobble .45s}
@keyframes pop{0%{transform:scale(.85)}60%{transform:scale(1.06)}100%{transform:scale(1)}}
@keyframes wobble{25%{transform:rotate(-3deg)}75%{transform:rotate(3deg)}}

.answers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px}
.ans-btn{font-size:clamp(22px,5vw,40px);padding:.5em .2em}
.ans-btn.wrong{--c:#c3c9e4;--cd:#8f98c4;color:#5b6490;animation:wobble .4s}
.ans-btn.right{--c:var(--green);--cd:var(--green-d);animation:pop .4s}

.prog{display:flex;align-items:center;justify-content:center;gap:12px;flex:none;font-weight:800;color:var(--muted)}
.bar{flex:0 1 260px;height:14px;border-radius:99px;background:var(--surface);box-shadow:inset 0 2px 4px rgba(0,0,0,.12);overflow:hidden}
.bar i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--yellow),var(--orange));transition:width .5s}
.tgrid{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(10px,2vw,22px);
  width:min(100%,calc((var(--vh) - 200px) * 1.9),1100px);margin:0 auto;
}
@media (max-aspect-ratio:1/1){.tgrid{grid-template-columns:repeat(2,minmax(0,1fr));width:min(100%,calc((var(--vh) - 200px) * .72),560px)}}
.tcard{position:relative;aspect-ratio:4/3;perspective:900px;cursor:pointer;container-type:inline-size}
@media (max-aspect-ratio:1/1){.tcard{aspect-ratio:1/.92}}
.tcard-in{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .65s cubic-bezier(.4,.2,.2,1)}
.tcard.flipped .tcard-in{transform:rotateY(180deg)}
.tface{
  position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:26px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:10px;
  box-shadow:0 7px 0 var(--cd),var(--card-shadow);
}
.tfront{
  color:#fff;background:
    radial-gradient(circle at 20% 15%,rgba(255,255,255,.28) 0 14%,transparent 15%),
    radial-gradient(circle at 85% 85%,rgba(255,255,255,.18) 0 22%,transparent 23%),
    var(--c);
}
.tnum{font-family:var(--font-h);font-weight:700;font-size:72px;font-size:clamp(44px,40cqw,120px);line-height:1;text-shadow:0 4px 0 rgba(0,0,0,.18)}
.tback{transform:rotateY(180deg);background:var(--tint);color:#1b2547;border:4px solid var(--c);gap:2px}
.temoji{font-size:56px;font-size:clamp(34px,24cqw,90px);line-height:1.1}
.tname{font-family:var(--font-h);font-weight:700;font-size:20px;font-size:clamp(16px,8.5cqw,30px)}
.tdesc{font-weight:700;font-size:11px;font-size:clamp(10px,4.8cqw,15px);line-height:1.25;padding:0 6px;opacity:.85}
.mini-btn{
  position:absolute;right:8px;bottom:8px;width:34px;height:34px;border-radius:50%;border:0;cursor:pointer;
  background:rgba(255,255,255,.85);font-size:16px;box-shadow:0 2px 0 rgba(0,0,0,.15);
}
.c-blue{--c:var(--blue);--cd:var(--blue-d);--tint:#dbeafe}
.c-green{--c:var(--green);--cd:var(--green-d);--tint:#d9f7e5}
.c-coral{--c:var(--coral);--cd:var(--coral-d);--tint:#ffe3df}
.c-yellow{--c:#f0ac00;--cd:var(--yellow-d);--tint:#fff1c2}
.c-pink{--c:var(--pink);--cd:var(--pink-d);--tint:#ffdcec}
.c-purple{--c:var(--purple);--cd:var(--purple-d);--tint:#e7defe}
.foot{display:flex;justify-content:center;flex:none}

.mstats{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;flex:none}
.mgrid{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(8px,1.6vw,16px);
  width:min(100%,calc((var(--vh) - 260px) * 1.28),900px);margin:0 auto;
}
@media (max-aspect-ratio:1/1){.mgrid{grid-template-columns:repeat(3,minmax(0,1fr));width:min(100%,calc((var(--vh) - 260px) * .72),560px)}}
.mcard{position:relative;aspect-ratio:1;perspective:800px;cursor:pointer}
.mcard-in{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.4,.2,.2,1)}
.mcard.flipped .mcard-in,.mcard.done .mcard-in{transform:rotateY(180deg)}
.mface{
  position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:20px;
  display:grid;place-items:center;box-shadow:0 5px 0 rgba(0,0,0,.2);
}
.mback{
  color:#fff;font-size:clamp(28px,7vw,54px);
  background:radial-gradient(circle at 25% 20%,rgba(255,255,255,.3) 0 16%,transparent 17%),linear-gradient(150deg,var(--purple),var(--blue));
}
.mfront{background:var(--face);transform:rotateY(180deg);padding:6%}
.mfront .clock{width:100%;height:100%}
.mcard.done .mfront{box-shadow:0 5px 0 var(--green),0 0 0 4px var(--green)}
.mcard.done{animation:pop .5s .45s}
.mdigital{font-family:var(--font-h);font-weight:700;color:var(--clock-ink);font-size:clamp(24px,6vw,52px)}

.home{
  flex:1;display:grid;gap:clamp(14px,3vw,30px);align-content:center;width:100%;max-width:1180px;margin:0 auto;
  grid-template-columns:minmax(0,1fr);
}
@media (min-width:900px) and (min-aspect-ratio:5/4){.home{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:center}}
.hero{display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px}
.hero-clock{
  --cs:clamp(150px,min(46vw,32vh),300px);
  border:0;padding:0;background:none;cursor:pointer;
}
@supports (height:100dvh){.hero-clock{--cs:clamp(150px,min(46vw,32dvh),300px)}}
@media (min-width:900px) and (min-aspect-ratio:5/4){.hero-clock{--cs:clamp(200px,min(34vw,62vh),440px)}}
.hero-clock:active{transform:scale(.98)}
.greet{margin:0;font-weight:800;color:var(--muted);font-size:clamp(16px,2.4vw,22px)}
.title{margin:0;font-family:var(--font-h);font-weight:700;line-height:1;font-size:clamp(38px,7.5vw,84px);letter-spacing:-.01em}
.lead{margin:0;font-weight:700;font-size:clamp(16px,2.4vw,22px);line-height:1.35;max-width:32ch}
.lead b{font-family:var(--font-h);font-weight:600;color:var(--coral)}
.rank{width:min(100%,360px);display:grid;gap:6px;justify-items:center;font-weight:800;color:var(--muted);font-size:clamp(13px,1.8vw,16px)}
.rank .bar{width:100%;flex:none}
.games{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(12px,2vw,24px)}
.gcard{
  --c:var(--blue);--cd:var(--blue-d);
  position:relative;overflow:hidden;text-align:left;border:0;cursor:pointer;color:#fff;
  display:flex;flex-direction:column;gap:6px;justify-content:flex-end;min-height:clamp(140px,22vh,210px);
  border-radius:30px;padding:clamp(14px,2.4vw,24px);background:var(--c);
  box-shadow:0 8px 0 var(--cd),0 18px 30px rgba(20,30,90,.18);
  transition:transform .12s,box-shadow .12s;
}
.gcard::before{content:'';position:absolute;right:-34px;top:-34px;width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.17)}
.gcard:hover{transform:translateY(-3px)}
.gcard:active{transform:translateY(6px);box-shadow:0 2px 0 var(--cd)}
.gicon{
  position:absolute;right:clamp(10px,2vw,20px);top:clamp(10px,2vw,18px);font-size:clamp(34px,6vw,58px);line-height:1;
}
.gtitle{font-family:var(--font-h);font-weight:700;font-size:clamp(18px,3vw,28px);line-height:1.1;max-width:9em}
.gsub{font-weight:800;opacity:.92;font-size:clamp(12px,1.8vw,16px)}
.gcard.blue{--c:var(--blue);--cd:var(--blue-d)}
.gcard.green{--c:var(--green);--cd:var(--green-d)}
.gcard.purple{--c:var(--purple);--cd:var(--purple-d)}
.gcard.orange{--c:var(--orange);--cd:var(--orange-d)}

.modal{
  position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:20px;
  background:rgba(14,20,54,.55);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);animation:fadeIn .25s;
}
.modal-card{
  background:var(--surface);color:var(--ink);border-radius:34px;padding:28px 32px;text-align:center;max-width:440px;
  box-shadow:0 24px 60px rgba(0,0,0,.35);animation:pop .4s;
}
.modal-card .big{font-size:72px;line-height:1}
.modal-card h2{margin:6px 0;font-family:var(--font-h);font-size:40px}
.modal-card p{margin:0 0 18px;font-weight:800;color:var(--muted);font-size:20px}
.modal-card .row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.toast{
  position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));z-index:70;
  transform:translate(-50%,30px);opacity:0;pointer-events:none;transition:.3s;

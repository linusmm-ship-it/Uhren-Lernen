function setGhost(svg, T) { rot(svg, 'ghost-hour', T * .5); rot(svg, 'ghost-min', T * 6); }
const unwrap = (prev, target) => prev + (mod(target - prev + 180, 360) - 180);

function header(title) {
  return `<header class="topbar">
    <button class="btn btn-ghost btn-sm" data-act="back" aria-label="Zurück zum Menü"><span aria-hidden="true">←</span><span class="hide-sm">Zurück</span></button>

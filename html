    <path class="gh hand-nt" data-rot="ghost-hour" d="${HOUR_D}" ${rotStyle(T * .5)}/>
    <path class="gh hand-nt" data-rot="ghost-min" d="${MIN_D}" ${rotStyle(T * 6)}/>
  </g>
  <g class="hand" data-rot="hour" ${rotStyle(T * .5)}>
    <path class="sh" d="${HOUR_D}" transform="translate(1.5 3)"/>
    <path class="hh" d="${HOUR_D}"/>
    ${knobs ? '<circle class="kn kn-h" cx="130" cy="80" r="7.5"/>' : ''}
  </g>
  <g class="hand" data-rot="min" ${rotStyle(T * 6)}>
    <path class="sh" d="${MIN_D}" transform="translate(1.5 3)"/>
    <path class="mh" d="${MIN_D}"/>
    ${knobs ? '<circle class="kn kn-m" cx="130" cy="38" r="7"/>' : ''}
  </g>
  ${sec ? `<g class="sec-g hand" data-rot="sec"><line x1="130" y1="152" x2="130" y2="26" stroke="#ff6b5e" stroke-width="2" stroke-linecap="round"/><circle cx="130" cy="130" r="5" fill="#ff6b5e"/></g>` : ''}
  <circle class="clk-hub" cx="130" cy="130" r="9"/>
  <circle cx="130" cy="130" r="3.5" fill="#fff"/>
  ${hit ? `<g>
    <line class="hit hand" data-hit="min"  data-rot="hit-min"  x1="130" y1="130" x2="130" y2="34" stroke-width="26" ${rotStyle(T * 6)}/>
    <line class="hit hand" data-hit="hour" data-rot="hit-hour" x1="130" y1="130" x2="130" y2="74" stroke-width="30" ${rotStyle(T * .5)}/>
  </g>` : ''}
</svg>`;
}
function rot(svg, key, deg) { $$(`[data-rot="${key}"]`, svg).forEach(el => { el.style.transform = `rotate(${deg}deg)`; }); }
function setHands(svg, T, instant) {
  if (instant) svg.classList.add('snap');
  rot(svg, 'hour', T * .5); rot(svg, 'hit-hour', T * .5);
  rot(svg, 'min', T * 6);   rot(svg, 'hit-min', T * 6);
  if (instant) { void svg.getBoundingClientRect(); svg.classList.remove('snap'); }

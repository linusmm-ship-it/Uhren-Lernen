}
function loop() {
  cx.clearRect(0, 0, W, H);
  parts = parts.filter(p => p.y < H + 30);
  for (const p of parts) {
    p.vy += .3; p.vx *= .992; p.x += p.vx; p.y += p.vy; p.r += p.vr;

addEventListener('resize', resizeCv); resizeCv();
const CONF = ['#ff6b5e', '#ffc83d', '#18a957', '#3b82f6', '#7c5cf0', '#ec4899'];
function confetti(n = 110, ox = .5, oy = .6) {
  if (reduceMotion) n = Math.min(n, 25);
  for (let i = 0; i < n; i++) {
    const a = (-90 + (Math.random() - .5) * 110) * Math.PI / 180, sp = 7 + Math.random() * 10;
    parts.push({ x: ox * W, y: oy * H, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, r: Math.random() * 6.28,
      vr: (Math.random() - .5) * .35, w: 6 + Math.random() * 7, h: 4 + Math.random() * 6, c: pick(CONF), round: Math.random() < .25 });

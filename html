function randTime(l, avoid = []) {
  let t, n = 0;
  do { t = { h: is24() ? rand(24) : 1 + rand(12), m: l.mins ? pick(l.mins) : rand(60) }; n++; }
  while (n < 40 && avoid.some(a => a && a.h === t.h && a.m === t.m));
  return t;
}
function makeOptions(t, l) {
  const okm = m => !l.mins || l.mins.includes(m);
  const norm = h => is24() ? mod(h, 24) : ((h - 1 + 12) % 12) + 1;
  const seen = new Set([t.h + ':' + t.m]), out = [];
  const add = (h, m) => {
    h = norm(h); m = mod(m, 60);
    const k = h + ':' + m;
    if (!okm(m) || seen.has(k)) return;
    seen.add(k); out.push({ h, m });
  };
  if (is24()) add(t.h + 12, t.m);
  if (t.m % 5 === 0) add(t.m / 5 || 12, (t.h % 12) * 5);
  add(t.h + 1, t.m); add(t.h - 1, t.m);
  const alt = l.mins ? shuffle(l.mins) : shuffle([1, -1, 5, -5, 10, -10, 15, 30].map(d => t.m + d));
  alt.forEach(m => add(t.h, m));
  let guard = 0;
  while (out.length < 4 && guard++ < 60) add(is24() ? rand(24) : 1 + rand(12), l.mins ? pick(l.mins) : rand(60));

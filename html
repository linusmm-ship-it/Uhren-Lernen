const C = 130;
const pt = (r, deg) => { const a = deg * Math.PI / 180; return [+(C + r * Math.sin(a)).toFixed(2), +(C - r * Math.cos(a)).toFixed(2)]; };
const HOUR_D = 'M125.5 145 L125 132 L127.4 82 Q130 74 132.6 82 L135 132 L134.5 145 Z';
const MIN_D  = 'M127 148 L126.6 132 L128.4 36 Q130 28 131.6 36 L133.4 132 L133 148 Z';
const rotStyle = deg => `style="transform:rotate(${deg}deg)"`;

function clockSVG(o = {}) {
  const { mini = false, knobs = false, sec = false, hit = false, T = 0, label = 'Uhr' } = o;
  let ticks = '';
  for (let i = 0; i < 60; i++) {
    const hr = i % 5 === 0; if (mini && !hr) continue;
    const [x1, y1] = pt(hr ? 90 : 99, i * 6), [x2, y2] = pt(106, i * 6);
    ticks += `<line class="${hr ? 'tk-h' : 'tk-m'}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`;
  }
  let nums = '';
  for (let h = 1; h <= 12; h++) {
    const [x, y] = pt(mini ? 68 : 72, h * 30);
    nums += `<text class="clk-num" x="${x}" y="${y}" font-size="${mini ? 34 : 28}">${h}</text>`;
  }
  let nums24 = '';
  if (!mini) for (let h = 1; h <= 12; h++) { const [x, y] = pt(42, h * 30); nums24 += `<text class="clk-n24" x="${x}" y="${y}" font-size="12.5">${h + 12}</text>`; }
